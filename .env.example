# Local : laisser vide pour passer par le proxy Vite (/api → localhost:4040)
# et éviter les erreurs CORS. Redémarrer `npm run dev` après changement.
VITE_API_BASE_URL=

# Prod / gateway distante (exemple) :
# VITE_API_BASE_URL=https://api.votredomaine.com

# CTA WhatsApp (pages marketing, ex. Courses particuliers) — URL complète wa.me ;
# si absent, repli sur le lien marketing par défaut
# VITE_WHATSAPP_WA_ME=https://wa.me/2376XXXXXXXX

# Recrutement (src/services/recruitmentApi.js) — si absent, repli : http://localhost:3000
# VITE_API_URL=http://localhost:3000

# POST /recruitment/apply — noms de champs multipart (optionnel)
# VITE_RECRUITMENT_PHOTO_FIELD=photo
# VITE_RECRUITMENT_CV_FIELD=cv
# VITE_RECRUITMENT_COVER_LETTER_FIELD=cover_letter
# VITE_RECRUITMENT_JOB_ID_FIELD=job_offer_id
# VITE_RECRUITMENT_NEIGHBORHOOD_FIELD=quartier

# ── Portail d'accès (site en construction) ───────────────────────────────
# Tant qu'un code est défini, le site entier est masqué derrière un écran
# d'accès et marqué noindex. Laisser VIDE en production pour que le site
# public s'affiche normalement.
#   VITE_SITE_GATE_CODE=un-code-partage
# Désactiver explicitement le portail même si un code traîne :
#   VITE_SITE_GATE=off
#
# Ouvrir le site SANS redéployer : le portail relit un drapeau à chaque
# chargement. Par défaut il lit /site-config.json (livré avec le site, donc
# modifiable seulement au déploiement). Pointer cette URL vers un hôte que
# vous pouvez éditer à chaud rend l'ouverture instantanée :
#   VITE_SITE_CONFIG_URL=https://gateway.livsight.com/api/public/site-config
# Le fichier doit répondre {"gate":"off"} pour ouvrir, {"gate":"on"} pour fermer.
# En cas d'échec de lecture, le site RESTE fermé.
