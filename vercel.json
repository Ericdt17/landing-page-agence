{
  "redirects": [
    {
      "source": "/plateforme/integrations-api",
      "destination": "/api-livraison",
      "permanent": true
    },
    {
      "source": "/plateforme/solution-client",
      "destination": "/livraison-stockage",
      "permanent": true
    },
    {
      "source": "/plateforme/portail-agent",
      "destination": "/application",
      "permanent": true
    },
    {
      "source": "/plateforme/portail-livreur",
      "destination": "/livraison-stockage",
      "permanent": true
    },
    {
      "source": "/plateforme/app-chauffeur",
      "destination": "/livraison-stockage",
      "permanent": true
    },
    {
      "source": "/en",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/es",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/es/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
